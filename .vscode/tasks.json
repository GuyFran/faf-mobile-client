{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FAF Mobile: Build Debug",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["assembleDebug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "FAF Mobile: Build Release",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["assembleRelease"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "FAF Mobile: Run Debug",
      "type": "shell",
      "command": "adb",
      "args": ["shell", "am", "start", "-n", "com.faforever.mobile/.MainActivity"],
      "dependsOn": ["FAF Mobile: Install to Device"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "FAF Mobile: Install Release to Device",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["installRelease"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "FAF Mobile: Run Release",
      "type": "shell",
      "command": "adb",
      "args": ["shell", "am", "start", "-n", "com.faforever.mobile/.MainActivity"],
      "dependsOn": ["FAF Mobile: Install Release to Device"],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "FAF Mobile: Install to Device",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["installDebug"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "FAF Mobile: Clean Build",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["clean", "assembleDebug"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "FAF Mobile: Uninstall from Device",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["uninstallDebug"],
      "group": "build",
      "problemMatcher": []
    }
  ]
}
